#include <stdio.h>
#include <stdlib.h>

// Node structure
struct Node {
    int val;
    struct Node* left;
    struct Node* right;
};

// Create a new node
struct Node* newNode(int val) {
    struct Node* node = (struct Node*)malloc(sizeof(struct Node));
    node->val = val;
    node->left = NULL;
    node->right = NULL;
    return node;
}

// Find all nodes in range [low, high]
void findInRange(struct Node* root, int low, int high) {
    if (root == NULL)
        return;

    // If current node is in range, explore both sides
    if (root->val >= low && root->val <= high) {
        findInRange(root->left, low, high);   // left first for sorted order
        printf("%d ", root->val);
        findInRange(root->right, low, high);
    }
    // If current node < low, answer is only in right subtree
    else if (root->val < low) {
        findInRange(root->right, low, high);
    }
    // If current node > high, answer is only in left subtree
    else {
        findInRange(root->left, low, high);
    }
}

int main() {
    // Example 1: l=4, h=24 → Expected: 4 9 17 18
    struct Node* root1 = newNode(17);
    root1->left        = newNode(4);
    root1->right       = newNode(18);
    root1->left->left  = newNode(2);
    root1->left->right = newNode(9);

    printf("Example 1 Output: ");
    findInRange(root1, 4, 24);
    printf("\n");

    // Example 2: l=13, h=23 → Expected: 16 20
    struct Node* root2 = newNode(16);
    root2->left        = newNode(7);
    root2->right       = newNode(20);
    root2->left->left  = newNode(1);
    root2->left->right = newNode(10);

    printf("Example 2 Output: ");
    findInRange(root2, 13, 23);
    printf("\n");

    return 0;
}
