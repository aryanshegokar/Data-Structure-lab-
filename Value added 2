#include <stdio.h>
#include <stdbool.h>
#include <stdlib.h>
#include <string.h>

bool isValid(char * s) {
    int len = strlen(s);
    
    // Quick optimization: an odd-length string can never be perfectly balanced.
    if (len % 2 != 0) {
        return false;
    }

    // Dynamically allocate memory for our stack based on string length
    char* stack = (char*)malloc(len * sizeof(char));
    if (stack == NULL) {
        return false; // Memory allocation failed
    }
    
    int top = -1; // -1 indicates an empty stack

    for (int i = 0; i < len; i++) {
        char current = s[i];

        // If it's an opening bracket, push to stack
        if (current == '(' || current == '{' || current == '[') {
            stack[++top] = current;
        } 
        // If it's a closing bracket
        else {
            // If the stack is empty, there's no matching opening bracket
            if (top == -1) {
                free(stack);
                return false;
            }

            char topElement = stack[top--]; // Pop the top element

            // Check if the closing bracket matches the last opened bracket
            if ((current == ')' && topElement != '(') ||
                (current == '}' && topElement != '{') ||
                (current == ']' && topElement != '[')) {
                free(stack);
                return false;
            }
        }
    }

    // If the stack is completely empty at the end, everything matched perfectly.
    bool result = (top == -1);
    
    // Clean up memory before returning
    free(stack);
    
    return result;
}
